# Copy to deploy/.env (gitignored) and change every value. Never commit deploy/.env.

# Signs the access tokens (HS256). At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me

# The first Admin, created at startup when no Admin exists yet.
ADMIN_EMAIL=admin@oliveconnect.tn
ADMIN_PASSWORD=change-me-too

# Optional: host port of the web container (default 80)
# HTTP_PORT=8080

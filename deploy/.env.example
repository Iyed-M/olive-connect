# Copy this file to deploy/.env and replace every example secret.
# Keep passwords hexadecimal (openssl rand -hex 32) because MONGO_URI contains
# the application password and does not URL-encode arbitrary punctuation.

JWT_SECRET=change-me-change-me-change-me-change-me
ADMIN_EMAIL=admin@oliveconnect.tn
ADMIN_PASSWORD=change-me-too

MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change-the-mongo-root-password
MONGO_APP_USER=oliveconnect
MONGO_APP_PASSWORD=change-the-mongo-app-password
MONGO_EXPORTER_USER=exporter
MONGO_EXPORTER_PASSWORD=change-the-mongo-exporter-password
MONGO_BACKUP_USER=backup
MONGO_BACKUP_PASSWORD=change-the-mongo-backup-password
REDIS_PASSWORD=change-the-redis-password

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-the-grafana-password

# Local defaults keep http://localhost usable. Set FORCE_HTTPS=true and use the
# real domain and Let's Encrypt directory on the VPS.
HTTP_PORT=80
HTTPS_PORT=443
FORCE_HTTPS=false
TLS_DOMAIN=localhost
LETSENCRYPT_DIR=./letsencrypt

# One trusted CIDR for /intranet/ and /grafana/. Use the office VPN or public IP.
# 192.0.2.1/32 is documentation-only and denies ordinary public clients.
INTRANET_ALLOWED_IP=192.0.2.1/32

# Optional rclone destination, for example an encrypted remote named offsite.
OFFSITE_REMOTE=

report/evidence/*.json
report/evidence/*.log
report/evidence/*.xml
report/evidence/*.html
report/evidence/screenshots/
report/diagrams/*.md
report/diagrams/*.mmd
report/diagrams/*.svg
report/diagrams/*.png

# Editors / OS
.idea/
.vscode/
*.iml
.DS_Store

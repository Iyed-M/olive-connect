# Agent skills: shared ones live in .agents/skills (Codex) and are symlinked
# into .claude/skills (Claude Code). Personal installs stay local.
.claude/*
!.claude/skills/
.agents/*
!.agents/skills/
.agents/skills/diagram-design/
.claude/skills/diagram-design
skills-lock.json

# Secrets
.env
*.env.local
deploy/mongo/keyfile

# Backend (Maven)
backend/target/

# Frontend (Node / Vite)
node_modules/
frontend/dist/
frontend/playwright-report/
frontend/test-results/

# M14 report build outputs and runtime evidence
report/.build/
report/OliveConnect-report.pdf
report/OliveConnect-report.docx
report/evidence/*
